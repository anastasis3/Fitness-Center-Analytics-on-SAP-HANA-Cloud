    </attribute>
    <attribute id="CAPACITY_STATUS" order="9" displayAttribute="false" attributeHierarchyActive="false">
      <descriptions defaultDescription="CAPACITY_STATUS"/>
      <keyMapping columnObjectName="CLASSES" columnName="CAPACITY_STATUS"/>
    </attribute>
