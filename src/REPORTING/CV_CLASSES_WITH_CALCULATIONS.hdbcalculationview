<Calculation:scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Calculation="http://www.sap.com/ndb/BiModelCalculation.ecore" id="CV_CLASSES_WITH_CALCULATIONS" applyPrivilegeType="NONE" dataCategory="CUBE" schemaVersion="3.0" hierarchyGeneration="SQL" outputViewType="Aggregation" application="BAS" cacheInvalidationPeriod="NONE" enforceSqlExecution="true">
<descriptions defaultDescription="CV_CLASSES_WITH_CALCULATIONS"/>
<localVariables/>
<variableMappings/>
<dataSources>
  <DataSource id="CLASSES$$$$CLASSES$$">
    <resourceUri>CLASSES</resourceUri>
  </DataSource>
</dataSources>
<snapshotProcedures/>
<calculationViews>
  <calculationView xsi:type="Calculation:ProjectionView" id="CLASSES">
    <viewAttributes>
      <viewAttribute id="ID"/>
      <viewAttribute id="NAME"/>
      <viewAttribute id="CATEGORY"/>
      <viewAttribute id="TRAINER_ID"/>
      <viewAttribute id="PRICE"/>
      <viewAttribute id="CLASS_DATE"/>
      <viewAttribute id="CAPACITY"/>
    </viewAttributes>
    <calculatedViewAttributes>
      <calculatedViewAttribute id="REVENUE_PER_SPOT" datatype="DECIMAL" length="13" scale="1" expressionLanguage="SQL">
        <formula>&quot;PRICE&quot; / &quot;CAPACITY&quot;</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="CLASS_SIZE" datatype="NVARCHAR" length="13" expressionLanguage="SQL">
        <formula>CASE
    WHEN &quot;CAPACITY&quot; &gt;= 20 THEN 'Large'
    WHEN &quot;CAPACITY&quot; &gt;= 12 THEN 'Medium'
    ELSE 'Small'
END</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="WEEKDAY_NAME" datatype="NVARCHAR" length="13" expressionLanguage="SQL">
        <formula>TO_VARCHAR(&quot;CLASS_DATE&quot;, 'DAY')</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="DAYS_UNTIL_CLASS" datatype="NVARCHAR" length="13" expressionLanguage="SQL">
        <formula>DAYS_BETWEEN(CURRENT_DATE, &quot;CLASS_DATE&quot;)</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="CLASS_CODE" datatype="NVARCHAR" length="13" expressionLanguage="SQL">
        <formula>LEFT(&quot;CATEGORY&quot;, 3) || '-' || LPAD(TO_VARCHAR(&quot;ID&quot;), 4, '0')</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="CAPACITY_STATUS" datatype="NVARCHAR" length="13" expressionLanguage="SQL">
        <formula>CASE
    WHEN &quot;CLASS_DATE&quot; &lt; CURRENT_DATE THEN 'Expired'
    WHEN &quot;CAPACITY&quot; IS NULL THEN 'Unknown'
    WHEN &quot;CAPACITY&quot; = 0 THEN 'Fully Booked'
    ELSE 'Available'
END</formula>
      </calculatedViewAttribute>
    </calculatedViewAttributes>
    <input node="CLASSES$$$$CLASSES$$"/>
  </calculationView>
</calculationViews>
