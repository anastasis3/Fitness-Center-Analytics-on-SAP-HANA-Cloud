COLUMN TABLE MEMBERS (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(100) UNIQUE,
    PHONE VARCHAR(30),
    MEMBERSHIP_TYPE VARCHAR(50),
    PRICE DECIMAL(10,2),
    DATE_OF_BIRTH DATE DEFAULT CURRENT_DATE,
    JOIN_DATE DATE,
    END_DATE DATE,
    STATUS VARCHAR(20)
);